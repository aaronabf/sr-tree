# Neon Postgres connection string.
# Use the *pooled* connection string from the Neon dashboard (host contains "-pooler").
# The Vercel <-> Neon integration sets this automatically as DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Tests (npm test) run against this database inside a throwaway schema.
# Use a Neon branch of the production database, never DATABASE_URL itself.
# Put it in .env.test.local so it stays out of the app's environment.
# TEST_DATABASE_URL=postgresql://user:password@ep-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Let people enter next year's edition. Leave unset until it's announced.
# NEXT_PUBLIC_ALLOW_NEXT_YEAR=true

# Per-IP write rate limit. Active in production by default; "on" forces it
# elsewhere, "off" disables it anywhere. Limit defaults to 30 per minute.
# RATE_LIMIT=on
# RATE_LIMIT_PER_MINUTE=30
